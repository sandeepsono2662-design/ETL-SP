from pyspark.sql import SparkSession

spark = SparkSession.builder \
    .appName("FruitNames") \
    .getOrCreate()

fruits = [
    ("Apple",),
    ("Banana",),
    ("Mango",),
    ("Orange",),
    ("Grapes",),
    ("Watermillan")
]

df = spark.createDataFrame(fruits, ["Fruit"])

df.show()

spark.stop()